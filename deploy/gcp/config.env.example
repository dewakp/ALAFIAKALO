# ALAFIA — Google Cloud deploy config. Copy to config.env and edit.
#   cp config.env.example config.env && $EDITOR config.env
# config.env is git-ignored (holds your project id); NEVER put secrets here —
# secrets go into Secret Manager (see provision.sh / the runbook), not this file.

# ── Project / region ─────────────────────────────────────────────────────────
export PROJECT_ID="your-gcp-project-id"
export REGION="europe-west1"          # Belgium: closest low-latency GCP region to
                                      # West Africa until GCP adds an African region.
export AR_REPO="alafia"               # Artifact Registry repository name

# ── Cloud SQL (PostgreSQL 16) ────────────────────────────────────────────────
export SQL_INSTANCE="alafia-db"
export SQL_TIER="db-custom-2-8192"    # 2 vCPU / 8 GB; drop to db-g1-small for a cheap start
export DB_NAME="alafia"
export DB_USER="alafia"
# The DB password + all app secrets are stored in Secret Manager, not here.

# ── Cloud Run service names ──────────────────────────────────────────────────
export SVC_BACKEND="alafia-backend"
export SVC_IDENTITY="alafia-identity"
export SVC_FRONTEND="alafia-frontend"

# ── Sizing ───────────────────────────────────────────────────────────────────
# Backend runs in-process schedulers (Firebase sync, practice geocode). On an
# autoscaled/scale-to-zero platform those must NOT fan out across instances, so
# the deploy pins backend to exactly one always-on instance and disables the
# schedulers by default (re-enable via Cloud Scheduler + a job later).
export BACKEND_MIN_INSTANCES="1"
export BACKEND_MAX_INSTANCES="1"
export FRONTEND_MIN_INSTANCES="0"
export FRONTEND_MAX_INSTANCES="4"
