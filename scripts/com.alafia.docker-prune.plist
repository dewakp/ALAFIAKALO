<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alafia.docker-prune</string>

    <!-- launchd is macOS's cron. Runs the prune script daily at 04:00.
         If the Mac is asleep at 04:00, launchd runs it on the next wake. -->
    <!-- Runs from ~/Library/Application Support, NOT ~/Documents (which is
         TCC-protected and blocks launchd from executing files there → exit 126). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/woleakpose/Library/Application Support/alafia/docker-prune.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/woleakpose/Library/Logs/alafia-docker-prune.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/woleakpose/Library/Logs/alafia-docker-prune.err.log</string>
</dict>
</plist>
