<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ALAFIA</string>
	<!-- ALAFIA is the PRODUCT; 6igma Health Inc is the company that publishes it.
	     App Review rejected build 1.5(10) under Guideline 5.1.1(ix), which
	     requires an app handling sensitive health data to be published under a
	     seller and company name associated with the organisation providing the
	     service. Nothing in the bundle named the publisher at all, so this key is
	     part of the answer to that, not decoration — and it must keep agreeing
	     with the App Store Connect seller name and with alafia.app/privacy. -->
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 6igma Health Inc. All rights reserved.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alafia</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.alafia.app</string>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.alafia.healthkit-sync</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>ALAFIA reads your health data to provide personalized health insights, track fitness progress, and sync wellness information across your devices.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>ALAFIA does not write data to Apple Health.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ALAFIA uses the microphone so you can speak your health logs and questions from the prompt page.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>ALAFIA transcribes your speech on device to understand spoken health logs and questions.</string>
	<!-- Camera is the DEFAULT source for every photo this app takes: a meal, a
	     medication label, a test strip. Without this key iOS does not deny the
	     camera, it TERMINATES the app the instant one is opened — so this key is
	     a prerequisite of the feature, not a nicety. -->
	<key>NSCameraUsageDescription</key>
	<string>ALAFIA uses your camera to photograph a meal, a medication label or a test strip so it can read them for you.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ALAFIA lets you attach a photo of a meal so it can estimate nutrition.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>ALAFIA uses Face ID to lock and unlock your health information so only you can open the app.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
