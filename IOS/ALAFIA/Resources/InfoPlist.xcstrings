    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA uses your camera to photograph a meal, a medication label or a test strip so it can read them for you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA utilise votre caméra pour photographier un repas, une étiquette de médicament ou une bandelette de test afin de les lire pour vous."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA uses Face ID to lock and unlock your health information so only you can open the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA utilise Face ID pour verrouiller et déverrouiller vos informations de santé afin que seul vous puissiez ouvrir l'application."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA reads your health data to provide personalized health insights, track fitness progress, and sync wellness information across your devices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA lit vos données de santé pour fournir des informations de santé personnalisées, suivre votre progression en matière de forme physique et synchroniser les informations de bien-être sur vos appareils."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA does not write data to Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA n'écrit pas de données dans Apple Health."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA uses the microphone so you can speak your health logs and questions from the prompt page."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA utilise le microphone pour que vous puissiez dicter vos journaux de santé et vos questions à partir de la page d'invite."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA lets you attach a photo of a meal so it can estimate nutrition."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA vous permet de joindre une photo d'un repas pour estimer la nutrition."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ALAFIA transcribes your speech on device to understand spoken health logs and questions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA transcrit votre parole sur l'appareil pour comprendre les journaux de santé et les questions parlés."
          }
        }
      }
    }
  },
  "version" : "1.2"
}