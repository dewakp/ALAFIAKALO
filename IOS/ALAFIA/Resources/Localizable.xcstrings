    "Tell ALAFIA what you ate, took, or how you feel — it'll take you to the right place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبر ALAFIA بما تناولته أو تناولت أو كيف تشعر — سيأخذك إلى المكان الصحيح"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagen Sie ALAFIA, was Sie gegessen haben, was Sie genommen haben oder wie Sie sich fühlen – es leitet Sie an die richtige Stelle weiter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale a ALAFIA qué comiste, qué tomaste o cómo te sientes — te llevará al lugar correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites à ALAFIA ce que vous avez mangé, pris ou comment vous vous sentez — elle vous dirigera au bon endroit."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaya wa ALAFIA abin da ka ci, ka ɗauka, ko yadda kake jiya — zai kawo da kai zuwa wuri daidai."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwa ALAFIA ihe ị riri, ihe ị natụ, ma ọ bụ otu ị na-ala — ọ ga-akpọ gị n'ebe kwesịrị ekwesị."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga ao ALAFIA o que você comeu, tomou ou como se sente — ele o levará ao lugar certo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mwambie ALAFIA kile ulichokula, ulichotaka, au jinsi unavyojisikia — itakukuwa mahali sahihi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sọ ALAFIA ohun tí o jẹ, oogun tí o gba, tàbí bí o ṣe máa lòó — yóò mú ọ lọ sí ibi tí ó yẹ"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉 ALAFIA 您吃了什么、服用了什么或感受如何 — 它会为您指引正确的方向"
          }
        }
      }
    },
