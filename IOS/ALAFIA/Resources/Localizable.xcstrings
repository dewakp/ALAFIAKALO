            "value" : "Toca el botón + para elegir entre métricas de Nutrición, Fitness, Humor, Signos vitales y Estilo de vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le bouton + pour choisir parmi les métriques Nutrition, Fitness, Humeur, Signes vitaux et Mode de vie."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danna maɓuɓɓugar + don zaɓi daga Abinci, Motsa Jiki, Zuciya, Mahimmancin Jiki, da Rayuwa."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taa + bọtụnụ ka ịhọrọ site na Nutrition, Fitness, Mood, Vitals, na Lifestyle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque o botão + para escolher entre métricas de Nutrição, Fitness, Humor, Sinais Vitais e Estilo de Vida."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa kitufe cha + ili kuchagua kutoka Nutrition, Fitness, Mood, Vitals, na Lifestyle metrics."
