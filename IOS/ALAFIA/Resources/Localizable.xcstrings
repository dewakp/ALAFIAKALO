    "Absent thrill — check access urgently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجفة غائبة — تحقق من الوصول بسرعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Thrill vorhanden — Zugang sofort überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin frémito — verificar acceso urgentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thrill absent — vérifier l'accès d'urgence."
          }
        },
