    "Any app or EHR system that writes to Apple Health will be automatically included in the sync." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي تطبيق أو نظام EHR يكتب إلى Apple Health سيتم تضمينه تلقائياً في المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App oder jedes EHR-System, das in Apple Health schreibt, wird automatisch in die Synchronisierung einbezogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier app o sistema EHR que escriba en Apple Health se incluirá automáticamente en la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute application ou système dossier médical électronique qui écrit dans Apple Health sera automatiquement inclus dans la synchronisation."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duk wata app ko EHR tsarin da ke rubuta zuwa Apple Health za a haɗa su kai tsaye."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihe ọ bụla app ma ọ bụ EHR sistemu na-ede na Apple Health ga-abụ n'ime njikọ na-agbanwe agbanwe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer app ou sistema EHR que escreva no Apple Health será incluído automaticamente na sincronização."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programu yoyote au mfumo wa EHR unaoandika kwenye Apple Health utajumuishwa otomatiki katika usambazaji."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohun èlò tàbí EHR ìṣẹ̀lẹ̀ tí ó ba kọ sí Apple Health yóò ṣàfikún ara rẹ̀ nínú ìfipamọ́."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何写入 Apple Health 的应用或 EHR 系统都将自动包含在同步中。"
          }
        }
      }
    },
