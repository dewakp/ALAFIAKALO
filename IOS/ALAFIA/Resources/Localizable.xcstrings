    "↑ aim for · ↓ stay under. Guidance from your biology & conditions — not medical advice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ استهدف · ↓ ابقَ تحت. إرشادات من حالتك الصحية وليست نصيحة طبية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ anstreben · ↓ nicht überschreiten. Orientierung von deiner Biologie & Erkrankungen — keine medizinische Beratung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ objetivo · ↓ no exceder. Orientación según tu salud y condiciones — no es consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ à viser · ↓ à ne pas dépasser. Conseils basés sur votre biologie et conditions — pas un avis médical."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ niyya · ↓ tsaya ƙasa. Jagora daga jiki & yanayi — ba shawarar likita ba."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ chọọ · ↓ nọrọ n'okpuru. Ntụziaka site n'ahụ gị & ọnọdụ — ọ bụghị ndụmọdụ ọgwụ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ procure · ↓ mantenha abaixo. Orientação baseada em seus dados e condições — não é aconselhamento médico."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ jaribu · ↓ kaa chini. Mwongozo kutoka kwa biolojia yako & hali — si ushauri wa kimatibabu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ ètò fún · ↓ dúró nípa. Ìtọ́sọ́nú láti ara rẹ & àwọn ìṣòro — kò sí ìmọ̀ ẹ̀kọ́ ìlera."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑ 目标值 · ↓ 不超过。根据您的身体状况和病情提供 — 非医学建议。"
          }
        }
      }
    },
