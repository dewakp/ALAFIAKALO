    "Data export requested. Check back in a few minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم طلب تصدير البيانات. تحقق مرة أخرى خلال دقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenexport angefordert. Bitte in wenigen Minuten erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solicitó la exportación de datos. Vuelve a consultar en unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export de données demandé. Vérifiez dans quelques minutes."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An bugi buɗe bayanan. Duba baya cikin 'yan mintuna."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rịọọla maka ịbupu data. Laghachi n'oge ole na ole."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportação de dados solicitada. Verifique novamente em alguns minutos."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombi la kuhamisha data limepokelewa. Angalia tena baada ya dakika chache."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbeèrè ìgbéjade dátà. Padà wò ní ìṣẹ́jú díẹ̀."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据导出已申请。请稍后查看。"
          }
        }
      }
    },
    "Data flows from Apple Health → ALAFIA only. We never write to Apple Health." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتدفق البيانات من Apple Health → ALAFIA فقط. لا نكتب إلى Apple Health أبداً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten fließen von Apple Health → ALAFIA nur in eine Richtung. Wir schreiben nie in Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos fluyen de Apple Health → ALAFIA solamente. Nunca escribimos en Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données proviennent d'Apple Health → ALAFIA uniquement. Nous n'écrivons jamais dans Apple Health."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayani yana zuwa Apple Health → ALAFIA kawai. Ba mu taɓa rubuta zuwa Apple Health ba."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data na-esite Apple Health → ALAFIA naanị. Anyị anaghị edekarị na Apple Health."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados fluem do Apple Health → ALAFIA apenas. Nunca escrevemos no Apple Health."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data inatoka Apple Health → ALAFIA tu. Hatuwezi kuandika kwenye Apple Health."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àlàyé ń ṣàn láti Apple Health → ALAFIA nìkan. A kò níí kọ sí Apple Health."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据从 Apple Health 流向 ALAFIA。我们从不写入 Apple Health。"
          }
        }
      }
