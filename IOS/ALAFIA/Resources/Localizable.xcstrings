    "An account holder must be an adult. A child is tracked as a dependent profile under a parent or guardian's account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون صاحب الحساب بالغاً. يتم تتبع الطفل كملف تابع تحت حساب الوالد أو الوصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kontoinhaber muss ein Erwachsener sein. Ein Kind wird als abhängiges Profil unter dem Konto eines Elternteils oder Betreuers erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El titular de la cuenta debe ser un adulto. Un menor se registra como perfil dependiente bajo la cuenta de un padre o tutor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titulaire du compte doit être un adulte. Un enfant est suivi comme profil dépendant sous le compte d'un parent ou tuteur."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai ajiyar asusu dole ne ya kasance mai girma. Yaro ana tuƙa shi a matsayin ɗan ƙasa a ƙarƙar asusu mai ƙarewa ko mai kulawa."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onye nwe akaụntụ ga-abụ nnukwu mmadụ. A na-eletụ nwa ọbụ ụmụ dị elu n'okpuru akaụntụ nne ma ọ bụ onye nlekọta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O titular da conta deve ser um adulto. Uma criança é acompanhada como perfil dependente sob a conta de um pai ou responsável."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mmiliki wa akaunti lazima awe mtu mzima. Mtoto hufuatiliwa kama profaili inayotegemea chini ya akaunti ya mzazi au mlezi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olùdálẹ̀ àkáwọ̀ gbọ́dọ̀ jẹ́ ọ̀dọ̀mọ̀ àgbà. Ọmọ kékeré ni a ṣe àkíyèsí gẹ́gẹ́ bi ọmọ ìbáṣepọ̀ nípa àkáwọ̀ obi tàbí olùtọ́jú."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户持有人必须是成年人。儿童作为受抚养人资料在父母或监护人的账户下进行跟踪。"
          }
        }
      }
    },
