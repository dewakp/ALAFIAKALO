    "ALAFIA helps you track nutrition, fitness, lab results, medications, mood, and lifestyle — all in one place. Use the AI assistant for personalized health insights." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA vous aide à suivre la nutrition, la forme physique, les résultats de laboratoire, les médicaments, l'humeur et le mode de vie — tout en un seul endroit. Utilisez l'assistant IA pour des conseils de santé personnalisés."
          }
        }
      }
    },
    "ALAFIA Membership" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhésion ALAFIA"
          }
        }
      }
    },
    "ALAFIA needs an active membership. Subscribe to continue — if you already pay on another device, restore it below." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALAFIA nécessite une adhésion active. Abonnez-vous pour continuer — si vous payez déjà sur un autre appareil, restaurez-le ci-dessous."
          }
        }
      }
    },
