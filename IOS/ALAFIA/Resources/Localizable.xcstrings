    "Separate foods with semicolons — ALAFIA will recognize this meal in future photos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افصل الأطعمة بفواصل منقوطة — ستتعرف ALAFIA على هذه الوجبة في الصور المستقبلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebensmittel mit Semikolons trennen — ALAFIA erkennt diese Mahlzeit in zukünftigen Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa los alimentos con punto y coma — ALAFIA reconocerá esta comida en futuras fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparez les aliments par des points-virgules — ALAFIA reconnaîtra ce repas dans les futures photos."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raba abinci da semicolons — ALAFIA zai gane wannan abinci a cikin hotuna na gida."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kewaa nri site na semicolons — ALAFIA ga-amata nri a na foto ndị na-abịa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe os alimentos com ponto-e-vírgula — ALAFIA reconhecerá esta refeição em futuras fotos."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenga chakula kwa semicolons — ALAFIA itajua hii chakula katika picha za baadaye."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
