    "Patients appear here as soon as they share their records with you, from Share Records, using your account email." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر المرضى هنا فور مشاركتهم سجلاتهم معك من خيار مشاركة السجلات باستخدام بريدك الإلكتروني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patienten erscheinen hier, sobald sie ihre Aufzeichnungen über „Aufzeichnungen teilen\" mit Ihrem Konto-E-Mail mit Ihnen teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pacientes aparecen aquí tan pronto como compartan sus registros contigo, desde Compartir registros, usando el correo de tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les patients apparaissent ici dès qu'ils partagent leurs dossiers avec vous, depuis Partager les dossiers, en utilisant l'adresse e-mail de votre compte."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu ciwon za su bayyana nan da zarar suka raba rikodin lafiyarsu da ku, daga Raba Rikodin, ta amfani da adireshin imel na akauntinku."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndị ọrịa ga-apụta ebe a ozugbo ha na-ekerịta ndekọ ha na gị, site na Ekerịta Ndekọ, site na imeeli akawụntụ gị."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pacientes aparecem aqui assim que compartilham seus registros com você, em Compartilhar Registros, usando o email da sua conta."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagonjwa watakuja hapa mara tu wanaposambaza rekodi zao kwako, kutoka Sambaza Rekodi, kwa kutumia barua pepe ya akaunti yako."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn ọmọ-ẹlẹ́rìí yoo han níhìn-ìbá tí wọn ba pín àwọn ìtàn ìlera wọn pẹ̀lú ẹ, láti Pín Àwọn Ìtàn, nípa lo ọ̀rọ̀ imeèlì akáọ̀ọ́ rẹ."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者使用您的账户邮箱从\"分享记录\"分享记录后，会立即显示在此处。"
          }
        }
      }
    },
