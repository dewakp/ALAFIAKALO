        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est correct — l'enregistrer quand même"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan daidai ne — rubuta shi daidai da haka"
