        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn èsì ìsẹ̀wọ̀ rẹ yóò hàn níbí gẹ́gẹ́ bí àwọn awòkọ̀ nígbà tí dátà bá wà."
