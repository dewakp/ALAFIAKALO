    "A direct message goes to one person. Remove them to pick someone else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسالة المباشرة تذهب لشخص واحد. احذفهم لاختيار شخص آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Direktnachricht geht an eine Person. Entfernen Sie sie, um jemand anderen auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje directo va a una persona. Elimínala para elegir a otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un message direct va à une seule personne. Supprimez-la pour en choisir une autre."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakin jiya zuwa mutum ɗaya ne. Cire su don zaɓi wani."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ozi ozugbo na-aga n'otu mmadụ. Wepụ ha iji họpụta onye ọzọ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mensagem direta vai para uma pessoa. Remova-a para escolher outra."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujumbe wa moja kwa moja huenda kwa mtu mmoja. Waondoe ili kuchagua mtu mwingine."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ifiránilẹ̀ dìrẹ̀ lọ sí ẹnìkan. Yọ wọn kúrò láti yan ẹnìkan míìrán."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私信只发送给一个人。删除他们以选择其他人。"
          }
        }
      }
    },
