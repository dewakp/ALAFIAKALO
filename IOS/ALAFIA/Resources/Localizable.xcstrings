    "Search by name, abbreviation or code — try “kidney”, “ESRD”, “sickle cell” or “GB61.5”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث بالاسم أو الاختصار أو الرمز — جرّب \"kidney\" أو \"ESRD\" أو \"sickle cell\" أو \"GB61.5\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Name, Abkürzung oder Code suchen — versuchen Sie „kidney\", „ESRD\", „sickle cell\" oder „GB61.5\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar por nombre, abreviatura o código — prueba con \"kidney\", \"ESRD\", \"sickle cell\" o \"GB61.5\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher par nom, abréviation ou code — essayez « kidney », « ESRD », « sickle cell » ou « GB61.5 »."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bincika ta suna, gajeren suna ko lambar — yi kokarin \"kidney\", \"ESRD\", \"sickle cell\" ko \"GB61.5\"."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọọ site na aha, nkọwapụta mkpụkpụ, ma ọ bụ koodu — gbalịa \"kidney\", \"ESRD\", \"sickle cell\" ma ọ bụ \"GB61.5\"."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquise por nome, abreviatura ou código — tente \"kidney\", \"ESRD\", \"sickle cell\" ou \"GB61.5\"."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tafuta kwa jina, kifupi au nambari — jaribu \"kidney\", \"ESRD\", \"sickle cell\" au \"GB61.5\"."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wá nípa orúkọ, àkọ́kọ́ tàbí kóòdù — gbìyànjú \"kidney\", \"ESRD\", \"sickle cell\" tàbí \"GB61.5\"."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按名称、缩写或代码搜索——尝试\"kidney\"、\"ESRD\"、\"sickle cell\"或\"GB61.5\"。"
          }
        }
      }
    },
