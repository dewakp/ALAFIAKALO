    },
    "This patient shares all of their data with you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المريض يشارك جميع بيانته معك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Patient teilt alle seine Daten mit Ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este paciente comparte todos sus datos contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce patient partage toutes ses données avec vous."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan maroki yana raba duk bayanansu tare da ku."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onye ọrịa a na-ekerịta data niile ha na gị."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este paciente compartilha todos os seus dados com você."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mgonjwa huyu anashiriki data yake yote ya afya na wewe."
          }
