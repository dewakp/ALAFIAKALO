    "Suggestions — final nutrients are computed server-side when you save." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاقتراحات — يتم حساب العناصر الغذائية النهائية من جانب الخادم عند الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge — endgültige Nährstoffe werden serverseitig berechnet, wenn Sie speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerencias — los nutrientes finales se calculan en el servidor cuando guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions — les nutriments finaux sont calculés côté serveur lors de l'enregistrement."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shawarwari — a ƙididdige abubuwan gida a gefen sabar lokacin da kake ajiye."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndụmọdụ — a na-agbakọ ihe ọ bụla n'ụlọ ọrụ mgbe ị na-echekwa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugestões — os nutrientes finais são calculados no servidor quando guarda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapendekezo — virutubishi vya mwisho vinakokotwa upande wa seva wakati wa kuokoa."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn ìmọ̀ràn — a ń ṣe àpèjọ́ àwọn ìjẹ́ ìkẹ́kọ̀ọ̀ ní ẹ̀rọ nígbà tí o bá tọ́jú."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议 — 最终营养数据在您保存时由服务器计算。"
          }
        }
      }
    },
