    "Add your age, height & weight in Profile for goals tailored to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف عمرك وطولك ووزنك في الملف الشخصي للحصول على أهداف مخصصة لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Ihr Alter, Ihre Größe und Ihr Gewicht im Profil ein, um personalisierte Ziele zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu edad, altura y peso en Perfil para objetivos personalizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre âge, taille et poids dans le Profil pour des objectifs personnalisés."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ƙara shekararku, tsayinku da nauyin jiki a Profile don manufofin da suka dace da ku."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinye afọ gị, ogologo ahụ & ibu gị na Profile maka ebumnobi akọrọ maka gị."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione sua idade, altura e peso no Perfil para objetivos personalizados."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza umri, urefu na uzani wako katika Wasifu kwa malengo yaliyoandaliwa kwako."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣafikun ọjọ́ ibadandun rẹ, giga ati iwuwo ninu Profile fun awọ iṣẹ́ ti o yẹ fun ọ."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在个人资料中添加您的年龄、身高和体重，以获得为您量身定制的目标。"
          }
        }
      }
    },
