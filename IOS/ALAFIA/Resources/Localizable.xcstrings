    "Log weight in Vitals, Meals, Elimination or Therapy to see the trend." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الوزن في العلامات الحيوية أو الوجبات أو الإخراج أو العلاج لرؤية الاتجاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewicht unter Vitalzeichen, Mahlzeiten, Ausscheidung oder Therapie protokollieren, um den Trend zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre el peso en Signos vitales, Comidas, Eliminación o Terapia para ver la tendencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le poids dans Signes vitaux, Repas, Élimination ou Traitement pour voir la tendance."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rubuta nauyi a Sigogi, Abinci, Kawar Jari ko Jiya don ganin ci gaba."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekọ ibu na Ihe Ọ Dị Mma, Nri, Ịchụ Mmiri ma ọ bụ Ọgwụgwọ iji hụ mgbanwe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre o peso em Sinais Vitais, Refeições, Eliminação ou Terapia para ver a tendência."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekodi uzani katika Dalili Muhimu, Chakula, Kuondolewa au Tiba ili kuona mwenendo."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣe ìwé ìwọ̀n nínú Àwọn Ìyẹ̀, Oúnjẹ, Ìfúnilẹ̀ tàbí Ìṣègun láti rí ìtẹ̀síwájú."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在生命体征、饮食、排泄或治疗中记录体重以查看趋势。"
          }
        }
      }
    },
