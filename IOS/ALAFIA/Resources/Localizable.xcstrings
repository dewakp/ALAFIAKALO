    "Coming soon — connect to grocery services for automatic reordering when items run low." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قريباً — الاتصال بخدمات البقالة لإعادة الطلب تلقائياً عند انخفاض المخزون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demnächst verfügbar — Verbindung zu Lebensmittellieferdiensten für automatische Nachbestellungen bei niedrigem Bestand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximamente — conecta con servicios de compras para reordenar automáticamente cuando los artículos escaseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bientôt disponible — connectez-vous aux services d'épicerie pour réapprovisionner automatiquement quand les articles manquent."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zai zo gida — haɗa da ayyukan kasuwa don sake buɗewa lokacin da kaya suka rasa."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga-abịa — jikọ na ụlọ ahịa maka ịmegharị ihe mgbe ha rụrụ ala."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em breve — conecte a serviços de compras para reordenação automática quando itens acabarem."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inakuja — unganisha kwa huduma za duka ili kuagiza tena kiotomatiki wakati vitu vipungue."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ń bọ̀ — lo sí àwọn ìlé ìtajà fún àtúndarí ní ìgbà tí ohun kò pọ̀."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将推出 — 连接杂货店服务，当物品库存不足时自动重新订购。"
          }
        }
      }
    },
