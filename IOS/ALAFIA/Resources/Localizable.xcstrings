    "Each health record has a unique ID. Re-syncing the same data will not create duplicates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل سجل صحي معرّف فريد. إعادة مزامنة البيانات نفسها لن تنشئ نسخاً مكررة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Gesundheitsdatensatz hat eine eindeutige ID. Das erneute Synchronisieren derselben Daten erstellt keine Duplikate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada registro de salud tiene un ID único. Resincronizar los mismos datos no creará duplicados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque dossier de santé a un identifiant unique. La resynchronisation des mêmes données ne créera pas de doublons."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kowane bayanan lafiya yana da nuni na musamman. Sake-juyawa na bayanan gida ba zai haifar da maimaita ba."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọrụ ike ọ bụla nwere ID pụrụ iche. Ịgbakọ data otu a ọzọ agaghị emepụta ndị ọzọ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada registro de saúde tem um ID único. Ressincronizar os mesmos dados não criará duplicatas."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kila rekodi ya afya ina kitambulisho cha kipekee. Kusambaza tena data sawa haitaunda nakala."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gbogbo àlàyé ìlera ní ID àkọ́tọ̀. Ìṣe-ìgbàlódé àlàyé kanna kò máa ṣẹ̀dá àwọn ìtúpo."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条健康记录都有唯一 ID。重新同步相同数据不会创建重复项。"
          }
        }
      }
    },
