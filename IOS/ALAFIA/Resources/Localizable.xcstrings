    "We sent a link to %@. Open it, then come back and tap Continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا رابطًا إلى %@. افتحه، ثم عد وانقر على متابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben einen Link an %@ gesendet. Öffnen Sie ihn und tippen Sie dann auf Weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos un enlace a %@. Ábrelo y luego vuelve y toca Continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien à %@. Ouvrez-le, puis revenez et appuyez sur Continuer."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mun aika haɗi zuwa %@. Buɗe shi, sannan koma da taɓa Ci gaba."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyị zịrị njikọ na %@. Meghee ya, wee laghachi ma pịa Gaa n'ihu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviámos uma ligação para %@. Abra-a e depois volte e toque em Continuar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumetuma kiungo kwa %@. Fungua kiungo, kisha rudi na gusa Endelea."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ranṣẹ ọna si %@. Ṣi i, lẹhinna pada ki o tẹ Tẹsiwaju."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们已向 %@ 发送链接。打开链接后，返回此处并点击继续。"
          }
        }
      }
    },
