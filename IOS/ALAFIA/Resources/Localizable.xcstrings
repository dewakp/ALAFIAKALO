    "Account deletion requested. You will be contacted for confirmation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم طلب حذف الحساب. سيتم التواصل معك للتأكيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontolöschung angefordert. Sie werden zur Bestätigung kontaktiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solicitó la eliminación de la cuenta. Nos pondremos en contacto para confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppression de compte demandée. Vous serez contacté pour confirmation."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An jiya a bugi akaonti. Za a tuntubaɗa ka don tabbatarwa."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A na-arịọ maka ịhichapụ akaụntụ. A ga-akpọ gị maka nkwenye."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclusão de conta solicitada. Você será contatado para confirmação."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombi la kufuta akaunti limepokelewa. Utawasiliana naye kwa uthibitisho."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìbeèrè paré àkáùnt. A yóò ká ọ́ fún ìdánilójú."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户删除已申请。我们将与您联系以确认。"
          }
        }
      }
    },
