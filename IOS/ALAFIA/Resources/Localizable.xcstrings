    "Billed %@ through the App Store. Cancel anytime in Settings → Apple ID → Subscriptions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الفوترة %@ عبر App Store. يمكنك الإلغاء في أي وقت من خلال الإعدادات → Apple ID → الاشتراكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgerechnet %@ über den App Store. Jederzeit kündbar unter Einstellungen → Apple ID → Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturado %@ a través de App Store. Cancela en cualquier momento en Configuración → Apple ID → Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturé %@ via l'App Store. Annulez à tout moment dans Réglages → Apple ID → Abonnements."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An bugi %@ ta hanyar App Store. Soke a kowane lokaci a Saiti → Apple ID → Subscriptions."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gbara gị ego %@ site na App Store. Kagbuo oge ọbụla na Settings → Apple ID → Subscriptions."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrado %@ através da App Store. Cancele a qualquer momento em Configurações → Apple ID → Assinaturas."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulipwa %@ kupitia App Store. Ghairi wakati wowote katika Settings → Apple ID → Subscriptions."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gba owó %@ nípa App Store. Fa kúrò nígbàkúgbà nínú Settings → Apple ID → Subscriptions."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 App Store 计费 %@。可随时在设置 → Apple ID → 订阅中取消。"
          }
        }
      }
    },
