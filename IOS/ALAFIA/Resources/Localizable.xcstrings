        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está correto — registrar mesmo assim"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hii ni sahihi — iandike hata hivyo"
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Èyí dúró — tẹ̀ e sílẹ̀ dáadáa"
